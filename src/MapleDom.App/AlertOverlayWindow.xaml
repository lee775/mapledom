<Window x:Class="MapleDom.App.AlertOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MapleDom 알림" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" IsHitTestVisible="False"
        WindowStartupLocation="Manual" FontFamily="맑은 고딕">
    <!-- 화면 알림 배너: 클릭을 통과시키고 포커스를 뺏지 않는다(코드 비하인드에서 확장 스타일 지정). -->
    <Border x:Name="Root" CornerRadius="14" Padding="40,20" BorderThickness="3" Background="#111722" BorderBrush="#FFB357">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.85" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontWeight="Bold" Foreground="#FFD9A0" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock x:Name="MessageText" Foreground="#F2F2F2" HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="1100" />
        </StackPanel>
    </Border>
</Window>
