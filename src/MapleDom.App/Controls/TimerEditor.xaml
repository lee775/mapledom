<UserControl x:Class="MapleDom.App.Controls.TimerEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MapleDom.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Field" TargetType="DockPanel"><Setter Property="Margin" Value="0,0,0,7" /><Setter Property="LastChildFill" Value="True" /></Style>
        <Style TargetType="Label">
            <Setter Property="Width" Value="144" /><Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,2,8,0">
            <DockPanel Style="{StaticResource Field}"><Label Content="이름" Target="{Binding ElementName=NameInput}" /><TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="이름" /></DockPanel>
            <DockPanel Style="{StaticResource Field}"><Label Content="간격 (초)" Target="{Binding ElementName=IntervalInput}" /><TextBox x:Name="IntervalInput" Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="간격 (초)" /></DockPanel>
            <DockPanel Style="{StaticResource Field}" Visibility="{Binding IsRepeat, Converter={StaticResource BoolVisibility}}"><Label Content="휴식 시간 (초)" /><TextBox Text="{Binding Gap, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="휴식 시간 (초)" /></DockPanel>
            <StackPanel Visibility="{Binding IsAcknowledge, Converter={StaticResource BoolVisibility}}">
                <DockPanel Style="{StaticResource Field}"><Label Content="선행 시간 (초)" ToolTip="버튼 누르는 시간 보정. 실제 카운트 = 간격 − 선행 시간" /><TextBox Text="{Binding Lead, UpdateSourceTrigger=PropertyChanged}" ToolTip="버튼 누르는 시간 보정" AutomationProperties.Name="선행 시간 (초)" /></DockPanel>
                <DockPanel Style="{StaticResource Field}"><Label Content="리마인드 간격 (초)" /><TextBox Text="{Binding Reminder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="리마인드 간격 (초)" /></DockPanel>
            </StackPanel>
            <CheckBox Content="앱 실행 시 자동 시작" IsChecked="{Binding AutoStart}" Margin="144,0,0,13" />
            <TextBlock Text="알림 프로필" FontWeight="SemiBold" Margin="0,0,0,9" />
            <DockPanel Style="{StaticResource Field}"><Label Content="제목" /><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="알림 제목" /></DockPanel>
            <DockPanel Style="{StaticResource Field}"><Label Content="본문 (메인)" /><TextBox Text="{Binding MainMessage, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="48" AutomationProperties.Name="본문 (메인)" /></DockPanel>
            <DockPanel Style="{StaticResource Field}" Visibility="{Binding IsAcknowledge, Converter={StaticResource BoolVisibility}}"><Label Content="본문 (리마인드)" /><TextBox Text="{Binding ReminderMessage, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="48" AutomationProperties.Name="본문 (리마인드)" /></DockPanel>
            <TextBlock Text="문구 토큰 안내 ⓘ" Foreground="{StaticResource Accent}" Margin="144,0,0,9" FontSize="11"
                       ToolTip="{}{name}: 타이머 이름&#x0a;{interval}: 설정 간격&#x0a;{n}: 리마인드 회차&#x0a;{overdue}: 본 알림 이후 경과" />
            <DockPanel Style="{StaticResource Field}"><Label Content="사운드" /><ComboBox ItemsSource="{x:Static vm:TimerSettingsEditor.Sounds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Sound}" AutomationProperties.Name="사운드" /></DockPanel>
            <DockPanel Style="{StaticResource Field}" Visibility="{Binding IsAcknowledge, Converter={StaticResource BoolVisibility}}"><Label Content="리마인드 사운드" /><ComboBox ItemsSource="{x:Static vm:TimerSettingsEditor.Sounds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ReminderSound}" AutomationProperties.Name="리마인드 사운드" /></DockPanel>
            <DockPanel Style="{StaticResource Field}"><Label Content="표시 방식" /><ComboBox ItemsSource="{x:Static vm:TimerSettingsEditor.Scenarios}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Scenario}" AutomationProperties.Name="표시 방식" /></DockPanel>
            <DockPanel Style="{StaticResource Field}"><Label Content="유지 시간 (초)" /><TextBox Text="{Binding Expire, UpdateSourceTrigger=PropertyChanged}" ToolTip="알림 센터 유지 시간. 0 이하는 만료 없음" AutomationProperties.Name="유지 시간 (초)" /></DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
