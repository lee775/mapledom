<Window x:Class="MapleDom.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MapleDom" Width="320" Height="246" ResizeMode="NoResize" Style="{StaticResource {x:Type Window}}"
        WindowStyle="None" Topmost="{Binding Topmost, Mode=TwoWay}" Opacity="{Binding Opacity}"
        WindowStartupLocation="Manual" MouseLeftButtonDown="OnDragWindow">
    <Border Background="{StaticResource Surface}" BorderBrush="#455164" BorderThickness="1" Padding="6,3,6,4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="27" />
                <RowDefinition Height="15" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" Foreground="{StaticResource Accent}" FontSize="9" Margin="2,0,6,0" />
                    <TextBlock Text="MAPLEDOM" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton Content="항상 위" IsChecked="{Binding Topmost}" Padding="7,1" FontSize="10" Height="21" Margin="0,0,5,0" AutomationProperties.Name="항상 위" />
                    <Button Content="×" Click="OnCloseClick" Width="23" Height="21" FontSize="16" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="닫기 (기본: 트레이로 숨기기)" AutomationProperties.Name="닫기" />
                </StackPanel>
            </Grid>
            <!-- 창 순서 카드: 정해 둔 창 순서를 적용/해제 -->
            <Border Grid.Row="1" DataContext="{Binding WindowOrder}" Margin="0,0,0,3" Padding="7,2" CornerRadius="4" BorderThickness="1" Height="54">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Panel}" />
                        <Setter Property="BorderBrush" Value="#303B49" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                <Setter Property="Background" Value="#2A3A4E" />
                                <Setter Property="BorderBrush" Value="#5C82B0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="창 순서" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Summary}" ToolTip="{Binding Summary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,7,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedText}" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" IsEnabled="{Binding IsEnabled}" Height="30" Margin="5,0,0,0" Padding="0" FontSize="11" FontWeight="SemiBold"
                            AutomationProperties.Name="{Binding ToggleLabel}" ToolTip="적용: 정한 순서로 정렬하고 유지 / 해제: 활성 창을 앞으로 올리고 Windows 기본대로 (Ctrl+Alt+Z)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="#394C47" /><Setter Property="BorderBrush" Value="#617E71" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsApplied}" Value="True"><Setter Property="Background" Value="#3E5A80" /><Setter Property="BorderBrush" Value="#7FA6DA" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Status}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Foreground="{StaticResource MutedText}" />
                </Grid>
            </Border>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,3" Padding="7,2" CornerRadius="4" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Panel}" />
                                    <Setter Property="BorderBrush" Value="#303B49" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Background" Value="#492A32" />
                                            <Setter Property="BorderBrush" Value="#A45B65" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /><ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,0,3,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Remaining}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,7,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedText}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsUrgent}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="2" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" Padding="0" Height="28" FontSize="11" AutomationProperties.Name="{Binding ToggleLabel}" ToolTip="{Binding Name}" />
                                <Button Grid.Column="3" Content="{Binding AcknowledgeLabel}" Command="{Binding AcknowledgeCommand}" Height="30" Margin="5,0,0,0" Padding="0" FontSize="11" FontWeight="SemiBold"
                                        Visibility="{Binding CanAcknowledge, Converter={StaticResource BoolVisibility}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#394C47" /><Setter Property="BorderBrush" Value="#617E71" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Background" Value="#853F4D" /><Setter Property="BorderBrush" Value="#E295A0" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Status}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#FFB4BB" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <UniformGrid Grid.Row="3" Columns="5">
                <UniformGrid.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="0" /><Setter Property="FontSize" Value="10" /><Setter Property="Margin" Value="1,0" /></Style></UniformGrid.Resources>
                <Button Content="전체 시작" Command="{Binding StartAllCommand}" />
                <Button Content="전체 정지" Command="{Binding StopAllCommand}" />
                <ToggleButton IsChecked="{Binding Muted}" Padding="0" FontSize="10" Margin="1,0" ToolTip="음소거 중에도 타이머는 계속 동작합니다" AutomationProperties.Name="음소거">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding MuteGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,3,0" /><TextBlock Text="음소거" /></StackPanel>
                </ToggleButton>
                <Button Content="설정" Click="OnSettingsClick" />
                <Button Content="테스트 알림" Command="{Binding TestCommand}" ToolTip="저장된 룬 알림을 보냅니다 (음소거 무시)" />
            </UniformGrid>
            <TextBlock Grid.Row="4" Text="{Binding Warning}" Foreground="{StaticResource Accent}" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding Warning}" Visibility="{Binding HasWarning, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Border>
</Window>
