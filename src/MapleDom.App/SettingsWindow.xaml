<Window x:Class="MapleDom.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MapleDom.App.Controls"
        xmlns:vm="clr-namespace:MapleDom.App.ViewModels"
        Title="MapleDom 설정" Width="570" Height="680" MinWidth="520" MinHeight="420" Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18,14" Background="{StaticResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,13"><TextBlock Text="설정" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="시간은 초 단위입니다. 저장하면 실행 중인 타이머와 창 순서에 바로 반영됩니다." Foreground="{StaticResource MutedText}" Margin="0,5,0,0" FontSize="11" /></StackPanel>
        <TabControl x:Name="SettingsTabs" Grid.Row="1">
            <TabItem Header="30초"><controls:TimerEditor DataContext="{Binding Minute}" /></TabItem>
            <TabItem Header="룬"><controls:TimerEditor DataContext="{Binding Rune}" /></TabItem>
            <TabItem Header="도핑"><controls:TimerEditor DataContext="{Binding Doping}" /></TabItem>
            <TabItem Header="알림 · 창">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="2,0,8,0">
                        <TextBlock Text="알림" FontWeight="SemiBold" Margin="0,2,0,6" />
                        <CheckBox Content="Windows 알림 사용" IsChecked="{Binding NotificationsEnabled}" />
                        <DockPanel Margin="0,8,0,15"><TextBlock Text="알림 최소 간격 (초)" Width="160" /><TextBox Text="{Binding MinSpacing, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="알림 최소 간격 (초)" /></DockPanel>
                        <TextBlock Text="화면 알림" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <TextBlock Text="알림이 울릴 때 화면에 큰 배너를 띄웁니다. 클릭을 통과시키고 포커스를 뺏지 않아 게임 조작에 방해가 되지 않습니다. 뜨는 위치는 타이머 탭에서 각각 정합니다." TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,7" />
                        <CheckBox Content="화면 알림 배너 사용" IsChecked="{Binding Overlay.Enabled}" />
                        <DockPanel Margin="0,9,0,0"><TextBlock Text="표시 시간 (초)" Width="110" VerticalAlignment="Center" /><TextBox Text="{Binding Overlay.Duration, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="화면 알림 표시 시간" /></DockPanel>
                        <DockPanel Margin="0,9,0,0"><TextBlock Text="글자 크기" Width="110" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Right" Text="{Binding Overlay.FontSize, StringFormat={}{0:F0}}" Width="34" TextAlignment="Right" /><Slider Minimum="20" Maximum="120" Value="{Binding Overlay.FontSize}" TickFrequency="2" SmallChange="2" IsSnapToTickEnabled="True" AutomationProperties.Name="화면 알림 글자 크기" /></DockPanel>
                        <DockPanel Margin="0,7,0,0"><TextBlock Text="불투명도" Width="110" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Right" Text="{Binding Overlay.Opacity, StringFormat={}{0:P0}}" Width="45" TextAlignment="Right" /><Slider Minimum="0.3" Maximum="1" Value="{Binding Overlay.Opacity}" TickFrequency="0.02" SmallChange="0.02" IsSnapToTickEnabled="True" AutomationProperties.Name="화면 알림 불투명도" /></DockPanel>
                        <Button Content="배너 미리보기" Click="OnOverlayPreview" HorizontalAlignment="Left" Margin="110,10,0,0" />
                        <TextBlock Text="창" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <CheckBox Content="항상 위에 표시" IsChecked="{Binding Topmost}" />
                        <CheckBox Content="닫기 버튼을 누르면 트레이로 숨기기" IsChecked="{Binding MinimizeToTray}" />
                        <TextBlock Text="창 투명도" Margin="0,12,0,4" />
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Opacity, StringFormat={}{0:P0}}" Width="45" HorizontalAlignment="Right" /><Slider Minimum="0.4" Maximum="1" Value="{Binding Opacity}" TickFrequency="0.05" SmallChange="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="창 투명도" /></DockPanel>
                        <TextBlock Text="전역 단축키" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <CheckBox Content="전역 단축키 사용" IsChecked="{Binding HotkeysEnabled}" />
                        <TextBlock Text="Ctrl+Alt+R   룬 깟음&#x0a;Ctrl+Alt+D   도핑했음&#x0a;Ctrl+Alt+S   전체 시작 / 정지&#x0a;Ctrl+Alt+Z   창 순서 적용 / 해제&#x0a;Ctrl+Alt+X   활성 창을 맨 앞으로 (잠깐 보기)" Foreground="{StaticResource MutedText}" LineHeight="22" Margin="20,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="창 순서">
                <Grid Margin="2,0,8,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="실행 중인 창을 목록에 넣고 위(앞)에서 아래 순서를 정합니다. 마지막 줄의 창이 맨 뒤(바닥)에 놓입니다. 메인 창의 [적용]을 누르면 이 순서가 유지되고, [해제]하면 활성 창을 앞으로 올리고 Windows 기본대로 돌아갑니다. 키 입력을 받는 창(활성 창)은 바뀌지 않습니다. 이 목록은 저장되지 않아 앱을 다시 켜면 비어 있습니다." TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,8" />
                    <StackPanel Grid.Row="1">
                        <CheckBox Content="맨 뒤 창을 뺀 나머지를 '항상 위' 층에 배치" IsChecked="{Binding WindowOrder.Topmost}" ToolTip="항상 위인 다른 창보다 앞에 두고 싶을 때 켭니다" />
                    </StackPanel>
                    <DockPanel Grid.Row="2" Margin="0,12,0,6">
                        <Button DockPanel.Dock="Right" Content="추가" Command="{Binding WindowOrder.AddCommand}" IsEnabled="{Binding WindowOrder.CanAdd}" MinWidth="52" Margin="5,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="새로고침" Command="{Binding WindowOrder.RefreshCommand}" MinWidth="64" Margin="5,0,0,0" />
                        <ComboBox ItemsSource="{Binding WindowOrder.Available}" DisplayMemberPath="Display" SelectedItem="{Binding WindowOrder.Selected}" AutomationProperties.Name="실행 중인 창" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding WindowOrder.Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Panel}" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="104" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Index}" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
                                            <Button Grid.Column="1" Content="▲" Command="{Binding MoveUpCommand}" Width="26" Padding="0" FontSize="10" AutomationProperties.Name="위로" ToolTip="위로 (앞으로)" />
                                            <Button Grid.Column="2" Content="▼" Command="{Binding MoveDownCommand}" Width="26" Padding="0" FontSize="10" Margin="3,0,6,0" AutomationProperties.Name="아래로" ToolTip="아래로 (뒤로)" />
                                            <TextBox Grid.Column="3" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" ToolTip="프로세스 이름 (exe 이름, 대소문자 무시)" AutomationProperties.Name="프로세스 이름" />
                                            <TextBox Grid.Column="4" Text="{Binding TitleContains, UpdateSourceTrigger=PropertyChanged}" Margin="5,0" ToolTip="창 제목에 포함될 문자열. 비우면 제목은 보지 않습니다" AutomationProperties.Name="제목 포함" />
                                            <TextBlock Grid.Column="5" Text="{Binding Marker}" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="6" Text="{Binding Status}" VerticalAlignment="Center" Width="34" FontSize="11" Margin="0,0,4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="#FF8A80" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsFound}" Value="True"><Setter Property="Foreground" Value="#8FD694" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="7" Content="삭제" Command="{Binding RemoveCommand}" Padding="6,0" FontSize="11" AutomationProperties.Name="삭제" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <DockPanel Grid.Row="4" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Left" Content="지금 정렬" Click="OnArrangeNow" ToolTip="편집 중인 목록으로 한 번 정렬해 봅니다 (저장·적용 상태는 바뀌지 않음)" />
                        <TextBlock Text="{Binding WindowOrder.Summary}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="텔레그램">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="2,0,8,0">
                        <TextBlock Text="켜면 Windows 알림과 함께 텔레그램 봇 메시지도 갑니다. @BotFather로 봇을 만들어 토큰을 붙여 넣고, 그 봇에게 아무 메시지나 보낸 뒤 [채팅 ID 찾기]를 누르세요." TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,10" />
                        <CheckBox Content="텔레그램 알림 사용" IsChecked="{Binding Telegram.Enabled}" />
                        <DockPanel Margin="0,12,0,7"><TextBlock Text="봇 토큰" Width="84" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" /><TextBox Text="{Binding Telegram.BotToken, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="봇 토큰" /></DockPanel>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock Text="채팅 ID" Width="84" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
                            <Button DockPanel.Dock="Right" Content="채팅 ID 찾기" Click="OnFindChatId" MinWidth="88" Margin="5,0,0,0" />
                            <TextBox Text="{Binding Telegram.ChatId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="채팅 ID" />
                        </DockPanel>
                        <TextBlock Text="보낼 알림" FontWeight="SemiBold" Margin="0,12,0,6" />
                        <CheckBox Content="30초 알림 (30초마다 메시지가 갑니다)" IsChecked="{Binding Telegram.SendMinute}" />
                        <CheckBox Content="룬" IsChecked="{Binding Telegram.SendRune}" Margin="0,4,0,0" />
                        <CheckBox Content="도핑" IsChecked="{Binding Telegram.SendDoping}" Margin="0,4,0,0" />
                        <DockPanel Margin="0,16,0,0">
                            <Button DockPanel.Dock="Left" Content="테스트 전송" Click="OnTelegramTest" ToolTip="편집 중인 토큰·채팅 ID로 메시지를 한 건 보냅니다 (저장하지 않음)" />
                            <TextBlock Text="{Binding Telegram.Status}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                        <TextBlock Text="봇 토큰은 이 PC의 설정 파일에 평문으로 저장됩니다. 알림 도착은 인터넷 상태에 따라 1초 안팎 걸릴 수 있습니다." TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Expander Grid.Row="2" Header="최근 알림 (최대 5개)" Margin="0,9,0,0">
            <ScrollViewer MaxHeight="100"><ItemsControl ItemsSource="{Binding RecentNotifications}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Expander>
        <Border Grid.Row="3" Background="#492A32" BorderBrush="#A45B65" BorderThickness="1" Padding="9" Margin="0,9,0,0" Visibility="{Binding HasErrors, Converter={StaticResource BoolVisibility}}">
            <ScrollViewer MaxHeight="95"><ItemsControl ItemsSource="{Binding Errors}" AutomationProperties.LiveSetting="Assertive"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#FFB4BB" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Border>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="테스트 알림은 저장된 설정을 사용합니다." Foreground="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,7" />
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Button Content="기본값 복원" Click="OnRestoreDefaults" Margin="0,0,7,0" />
                <Button Content="테스트 알림" Click="OnTest" ToolTip="선택한 타이머의 저장된 알림을 보냅니다. 타이머 탭이 아니면 룬을 사용합니다." />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" IsCancel="True" MinWidth="64" Margin="0,0,7,0" />
                <Button Content="저장" IsDefault="True" Click="OnSave" MinWidth="70" Background="#614629" BorderBrush="#BD8952" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
